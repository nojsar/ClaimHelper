rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function ownsCase(caseId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/cases/$(caseId))
        && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.ownerUid
             == request.auth.uid;
    }

    // Source uploads: PDF/JPG/PNG/HEIC/WebP up to 20 MB each. Source documents
    // are consumed only by Admin-SDK functions; clients never need direct read
    // or delete access. Keeping those operations server-only also prevents an
    // old anonymous identity from retaining document access after a case is
    // securely moved to an existing account.
    match /tempCases/{userId}/{caseId}/source/{fileName} {
      allow read, delete: if false;
      // Uploads are immutable once created. A client must use a fresh,
      // collision-resistant object name for every source document so an
      // already-extracted denial cannot be replaced in place.
      allow write: if resource == null
        && request.auth != null
        && request.auth.uid == userId
        && ownsCase(caseId)
        && request.resource.size <= 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)')
        );
    }

    // Generated exports (e.g. appeal_packet.pdf) are written by Functions;
    // owners may read/delete them.
    match /cases/{caseId}/exports/{fileName} {
      allow read, delete: if ownsCase(caseId);
      allow write: if false;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
