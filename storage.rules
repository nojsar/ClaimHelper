rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function ownsCase(caseId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.ownerUid
             == request.auth.uid;
    }

    // Source uploads: PDF/JPG/PNG/HEIC/WebP up to 20 MB each. Ownership is
    // enforced directly from the uid in the path (no cross-service
    // firestore.get, which fails intermittently). The extraction function
    // additionally verifies the caller owns the case.
    match /tempCases/{userId}/{caseId}/source/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)')
        );
    }

    // Generated exports (e.g. appeal_packet.pdf) are written by Functions;
    // owners may read/delete them.
    match /cases/{caseId}/exports/{fileName} {
      allow read, delete: if ownsCase(caseId);
      allow write: if false;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
