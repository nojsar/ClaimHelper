app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Cloud Functions
functions/node_modules/
functions/lib/
functions/.env
functions/.env.local
functions/.env.*.local
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Remotion social videos: dependencies and the headless browser it downloads.
# The rendered output in web/media/social/ IS committed — publishing must not
# depend on a render succeeding at post time.
video/node_modules/
video/out/
video/public/
video/src/queue.json
.remotion/

# Local code-graph analysis output
graphify-out/

# Secrets / local config — never commit real keys
.env
.env.local
**/serviceAccountKey.json
