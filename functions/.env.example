# ClaimHelper Cloud Functions environment
#
# PRODUCTION: set secrets with the Firebase CLI (never commit real keys):
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# EMULATOR: copy this file to functions/.env.local and fill in test values.

# --- Secrets (server-side only; NEVER placed in the Flutter app) ---
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Plain config ---
# OpenAI model used for extraction/preview/packet. Configurable, not hardcoded.
OPENAI_MODEL=gpt-5.5
# Deployed web app base URL, used to build Stripe success/cancel redirects.
APP_BASE_URL=http://localhost:5000
# Full Appeal Packet price in USD cents ($39.00).
FULL_PACKET_PRICE_CENTS=3900
# Hours before unsaved uploads are auto-deleted.
TEMP_FILE_TTL_HOURS=24
