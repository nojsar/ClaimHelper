# ClaimHelper Cloud Functions environment
#
# PRODUCTION: set secrets with the Firebase CLI (never commit real keys):
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# EMULATOR: copy this file to functions/.env.local and fill in test values.

# --- Secrets (server-side only; NEVER placed in the Flutter app) ---
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Plain config ---
# OpenAI model used for extraction/preview/packet. Configurable, not hardcoded.
OPENAI_MODEL=gpt-5.6-terra
# High reasoning balances drafting quality, latency, and API cost.
OPENAI_REASONING_EFFORT=high
OPENAI_SERVICE_TIER=default
OPENAI_INPUT_COST_PER_MILLION=2.5
OPENAI_CACHED_INPUT_COST_PER_MILLION=0.25
OPENAI_OUTPUT_COST_PER_MILLION=15
# Deployed web app base URL, used to build Stripe success/cancel redirects.
APP_BASE_URL=http://localhost:5000
# Full Appeal Packet price in USD cents ($39.00).
FULL_PACKET_PRICE_CENTS=3900
# Standalone Full Case price in USD cents ($59.00).
FULL_CASE_PRICE_CENTS=5900
# Upgrade difference after a customer already bought the $39 packet ($20.00).
FULL_CASE_UPGRADE_PRICE_CENTS=2000
# One additional follow-up drafting round ($19.00).
FOLLOWUP_ROUND_PRICE_CENTS=500
# Included rounds: 2 with a packet, up to 10 with Full Case.
FREE_FOLLOWUP_ROUNDS=2
FULL_CASE_ROUNDS_CAP=10
# Only an explicit preview-reminder opt-in extends an unpaid case this long.
REMINDER_OPT_IN_CASE_TTL_DAYS=14
# Hours before unsaved uploads are auto-deleted.
TEMP_FILE_TTL_HOURS=24
# Trustpilot BCC invitation address, from Trustpilot Business →
# Get reviews → Invitation methods. Treat it like a credential: anyone holding
# it can trigger invitations against the business profile. Leave empty to
# disable review invitations entirely.
TRUSTPILOT_INVITE_EMAIL=
# Days after a confirmed first purchase before the review invitation is sent.
REVIEW_INVITE_DELAY_DAYS=21
