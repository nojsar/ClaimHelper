{
  "name": "claimhelper-functions",
  "version": "1.0.0",
  "description": "ClaimHelper Firebase Cloud Functions (TypeScript)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test \"lib/test/*.test.js\"",
    "test:rules": "node --test \"rules/*.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.2.5",
    "openai": "^6.0.0",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.0.0",
    "firebase": "^12.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
