rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsCase() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Fields only Cloud Functions (Admin SDK, which bypasses rules) may set.
    function touchesServerOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paid', 'pricePaid', 'stripeSessionId', 'packet', 'preview',
        'ownerUid', 'storageOwnerUids', 'guestSessionId',
        'ownershipTransferredAt', 'createdAt', 'consentConfirmedAt',
        'followUps', 'followUpCredits', 'fullCase', 'generation',
        'caseTracker', 'analyticsMilestones'
      ]);
    }

    match /cases/{caseId} {
      // Cases are created by the createCaseUploadSession function, not the client.
      allow create: if false;
      allow read: if ownsCase();
      // Clients may edit their extraction review, guided answers, and status,
      // but can never grant themselves entitlements or rewrite payment state.
      allow update: if ownsCase() && !touchesServerOnlyFields();
      // Deletion goes through deleteCaseAndFiles so Storage is cleaned too,
      // but direct doc deletion by the owner is also allowed as a fallback.
      allow delete: if ownsCase();
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /purchases/{purchaseId} {
      // Written exclusively by the Stripe webhook (Admin SDK).
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /guestCaseClaims/{caseId} {
      // Short-lived, server-issued ownership-transfer authorizations. Neither
      // the anonymous source identity nor the destination account can inspect
      // or alter them directly; both phases go through callable functions.
      allow read, write: if false;
    }

    match /analytics_daily/{day} {
      // Aggregate, cookieless traffic counters written only by Cloud
      // Functions (Admin SDK). Readable solely by the owner account for the
      // in-app stats dashboard.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_segment_daily/{segment} {
      // Aggregate single-dimension traffic slices, written only by Cloud
      // Functions (Admin SDK). They contain no visitor/session identifiers.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_customer_daily/{day} {
      // Clean customer-only counters. Cloud Functions refuse every write that
      // originates from the owner account, and the dashboard reads only this
      // collection. The legacy analytics_daily collection remains an archive.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_customer_segment_daily/{segment} {
      // Customer-only country, referrer, campaign, and page aggregates.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }
  }
}
