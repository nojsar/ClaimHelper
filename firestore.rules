rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsCase() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function nullableStringWithin(value, limit) {
      return value == null || (value is string && value.size() <= limit);
    }

    function nullableAmount(value) {
      return value == null ||
        (value is number && value >= 0 && value <= 100000000);
    }

    // Only bounded scalar corrections can be made from the review screen.
    // Arrays and document snippets came from the server-side strict schema and
    // cannot be replaced with unbounded prompt content by a browser client.
    function isValidClientExtraction() {
      let next = request.resource.data.extraction;
      let prior = resource.data.extraction;
      return next is map
        && next.keys().hasAll([
          'documentType', 'denialCategory', 'insurerName', 'planName',
          'patientName', 'memberIdLast4', 'claimNumber', 'priorAuthNumber',
          'dateOfService', 'denialDate', 'appealDeadline', 'deniedItem',
          'providerName', 'prescriberName', 'denialReasonText', 'amountBilled',
          'patientResponsibility', 'appealInstructions', 'phoneNumbers',
          'mailingAddresses', 'missingFields', 'sourceSnippets'
        ])
        && next.keys().hasOnly([
          'documentType', 'denialCategory', 'insurerName', 'planName',
          'patientName', 'memberIdLast4', 'claimNumber', 'priorAuthNumber',
          'dateOfService', 'denialDate', 'appealDeadline', 'deniedItem',
          'providerName', 'prescriberName', 'denialReasonText', 'amountBilled',
          'patientResponsibility', 'appealInstructions', 'phoneNumbers',
          'mailingAddresses', 'missingFields', 'sourceSnippets'
        ])
        && next.documentType in [
          'denial_letter', 'eob', 'prior_authorization', 'bill', 'unknown'
        ]
        && next.denialCategory in [
          'medication', 'prior_authorization', 'not_medically_necessary',
          'step_therapy', 'formulary_exclusion', 'out_of_network',
          'excluded_benefit', 'duplicate_claim', 'missing_information',
          'experimental', 'partial_payment', 'unknown'
        ]
        && nullableStringWithin(next.insurerName, 300)
        && nullableStringWithin(next.planName, 300)
        && nullableStringWithin(next.patientName, 300)
        && nullableStringWithin(next.memberIdLast4, 20)
        && nullableStringWithin(next.claimNumber, 120)
        && nullableStringWithin(next.priorAuthNumber, 120)
        && nullableStringWithin(next.dateOfService, 80)
        && nullableStringWithin(next.denialDate, 80)
        && nullableStringWithin(next.appealDeadline, 160)
        && nullableStringWithin(next.deniedItem, 1000)
        && nullableStringWithin(next.providerName, 300)
        && nullableStringWithin(next.prescriberName, 300)
        && nullableStringWithin(next.denialReasonText, 8000)
        && nullableAmount(next.amountBilled)
        && nullableAmount(next.patientResponsibility)
        && next.appealInstructions == prior.appealInstructions
        && next.phoneNumbers == prior.phoneNumbers
        && next.mailingAddresses == prior.mailingAddresses
        && next.missingFields == prior.missingFields
        && next.sourceSnippets == prior.sourceSnippets;
    }

    // The web client has exactly three direct case-edit flows: extraction
    // corrections, appending uploaded source paths, and user additions. Every
    // retention, ownership, entitlement, payment, generation, and workflow
    // field is written through an Admin-SDK Cloud Function instead.
    function isValidClientCaseUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'extraction', 'sourceFilePaths', 'userAdditions', 'updatedAt'
        ])
        && changed.hasAll(['updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['extraction'])
          || isValidClientExtraction())
        && (!changed.hasAny(['sourceFilePaths'])
          || (request.resource.data.sourceFilePaths is list
            && request.resource.data.sourceFilePaths.size() <= 10))
        && (!changed.hasAny(['userAdditions'])
          || (request.resource.data.userAdditions is string
            && request.resource.data.userAdditions.size() <= 8000));
    }

    match /cases/{caseId} {
      // Cases are created by the createCaseUploadSession function, not the client.
      allow create: if false;
      allow read: if ownsCase();
      // Direct edits are deliberately narrow. In particular, clients cannot
      // set saved=true, clear expiresAt, move ownership, or grant themselves
      // paid/generated content.
      allow update: if ownsCase() && isValidClientCaseUpdate();
      // Deletion must go through deleteCaseAndFiles so the case document,
      // uploaded source documents, exports, and reminders are removed as one
      // server-authorized operation. Admin SDK calls bypass these rules.
      allow delete: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /purchases/{purchaseId} {
      // Written exclusively by the Stripe webhook (Admin SDK).
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /guestCaseClaims/{caseId} {
      // Short-lived, server-issued ownership-transfer authorizations. Neither
      // the anonymous source identity nor the destination account can inspect
      // or alter them directly; both phases go through callable functions.
      allow read, write: if false;
    }

    match /analytics_daily/{day} {
      // Aggregate, cookieless traffic counters written only by Cloud
      // Functions (Admin SDK). Readable solely by the owner account for the
      // in-app stats dashboard.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_segment_daily/{segment} {
      // Aggregate single-dimension traffic slices, written only by Cloud
      // Functions (Admin SDK). They contain no visitor/session identifiers.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_customer_daily/{day} {
      // Clean customer-only counters. Cloud Functions refuse every write that
      // originates from the owner account, and the dashboard reads only this
      // collection. The legacy analytics_daily collection remains an archive.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_customer_segment_daily/{segment} {
      // Customer-only country, referrer, campaign, and page aggregates.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_model_daily/{day} {
      // Aggregate model tokens, latency, and estimated spend only. No case,
      // prompt, user, or output data is written to this collection.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }
  }
}
