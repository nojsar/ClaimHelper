rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsCase() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // The web client has exactly three direct case-edit flows: extraction
    // corrections, appending uploaded source paths, and user additions. Every
    // retention, ownership, entitlement, payment, generation, and workflow
    // field is written through an Admin-SDK Cloud Function instead.
    function isValidClientCaseUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'extraction', 'sourceFilePaths', 'userAdditions', 'updatedAt'
        ])
        && changed.hasAll(['updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['extraction'])
          || request.resource.data.extraction is map)
        && (!changed.hasAny(['sourceFilePaths'])
          || request.resource.data.sourceFilePaths is list)
        && (!changed.hasAny(['userAdditions'])
          || request.resource.data.userAdditions is string);
    }

    match /cases/{caseId} {
      // Cases are created by the createCaseUploadSession function, not the client.
      allow create: if false;
      allow read: if ownsCase();
      // Direct edits are deliberately narrow. In particular, clients cannot
      // set saved=true, clear expiresAt, move ownership, or grant themselves
      // paid/generated content.
      allow update: if ownsCase() && isValidClientCaseUpdate();
      // Deletion must go through deleteCaseAndFiles so the case document,
      // uploaded source documents, exports, and reminders are removed as one
      // server-authorized operation. Admin SDK calls bypass these rules.
      allow delete: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /purchases/{purchaseId} {
      // Written exclusively by the Stripe webhook (Admin SDK).
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /guestCaseClaims/{caseId} {
      // Short-lived, server-issued ownership-transfer authorizations. Neither
      // the anonymous source identity nor the destination account can inspect
      // or alter them directly; both phases go through callable functions.
      allow read, write: if false;
    }

    match /analytics_daily/{day} {
      // Aggregate, cookieless traffic counters written only by Cloud
      // Functions (Admin SDK). Readable solely by the owner account for the
      // in-app stats dashboard.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_segment_daily/{segment} {
      // Aggregate single-dimension traffic slices, written only by Cloud
      // Functions (Admin SDK). They contain no visitor/session identifiers.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_customer_daily/{day} {
      // Clean customer-only counters. Cloud Functions refuse every write that
      // originates from the owner account, and the dashboard reads only this
      // collection. The legacy analytics_daily collection remains an archive.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }

    match /analytics_customer_segment_daily/{segment} {
      // Customer-only country, referrer, campaign, and page aggregates.
      allow read: if signedIn() && request.auth.uid == '6ZETq21uHIartXQlCCrZnZiQhb83';
      allow write: if false;
    }
  }
}
